    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
