# Stable Audio 3 Lab — environment configuration
#
# Copy to .env.local and edit. Precedence (last wins): host env > .env.local >
# this file (documentation/defaults only). Client-side UI controls persist
# separately in localStorage. Defaults shown reflect lib/server/config.ts and
# the Python scripts; see README "Environment variables" for the full reference.
#
# Paths below use placeholder names — replace <REPO_ROOT> with the absolute path
# to this checkout (e.g. $(pwd)). Never commit real secrets or tokens.

# ─── Generation core ───────────────────────────────────────────────────────

# Optional Hugging Face token: higher optimized-MLX download limits; required
# for the gated standard Torch checkpoints after you accept their license.
HF_TOKEN=

# true = generate a fake WAV without loading the model (fast UI/API testing).
# Unset (or any non-"true" value) = real inference. Shipped as true for safety.
STABLE_AUDIO_MOCK=true

# Python interpreter for the bridge script. Defaults to python3.
STABLE_AUDIO_PYTHON=python3

# Real inference backend: "mlx" (default/recommended on Apple Silicon) or
# "torch" for the standard PyTorch path.
STABLE_AUDIO_BACKEND=mlx

# Optional override for the vendored MLX runtime directory. Defaults to
# <REPO_ROOT>/vendor/stable-audio-3/optimized/mlx.
# STABLE_AUDIO_MLX_DIR=<REPO_ROOT>/vendor/stable-audio-3/optimized/mlx

# Generation/crop subprocess timeout in milliseconds. Default 900000 (15m).
STABLE_AUDIO_TIMEOUT_MS=900000

# MLX-only timeout override (milliseconds). Falls back to STABLE_AUDIO_TIMEOUT_MS
# when unset. Default 900000.
# STABLE_AUDIO_MLX_TIMEOUT_MS=900000

# ─── Security, rate limit, and concurrency ──────────────────────────────────

# Optional shared-secret bearer token that gates mutating /api/* routes
# (POST/PUT/PATCH/DELETE). UNSET BY DEFAULT: when empty, all routes work with
# no authentication (localhost/single-user mode). When set to a high-entropy
# value, mutating requests must send:
#   Authorization: Bearer <STABLE_AUDIO_ADMIN_TOKEN>
# Read-only GET routes (including public GET /api/radio JSON and the ?stream=1
# MP3 stream) are never gated. Never commit a real token; supply it via the
# operator environment.
# STABLE_AUDIO_ADMIN_TOKEN=

# Per-client rate limit for mutating /api/* requests (requests/minute, token
# bucket). 0 disables limiting. Default 30. Fail-open on cold restart.
# STABLE_AUDIO_MUTATING_RATE_PER_MINUTE=30

# Maximum heavy subprocesses (generation, crop, assessment) that may run
# concurrently. Default 1; raise only on hardware that can host multiple
# inferences without exhausting unified memory.
# STABLE_AUDIO_MAX_CONCURRENT=1

# ─── ffmpeg / ffprobe ───────────────────────────────────────────────────────

# Optional path to the ffmpeg binary. Defaults to "ffmpeg" (assumed on PATH).
# Used for MP3 conversion, crop rendering, duration validation, radio transcoding,
# and as the --ffmpeg-location hint for yt-dlp when set to a real path.
# FFMPEG_PATH=ffmpeg

# Optional path to the ffprobe binary. Defaults to "ffprobe" (assumed on PATH).
# Used for media-duration validation in crop and library flows.
# FFPROBE_PATH=ffprobe

# ─── Audio assessment (Qwen2.5-Omni-7B) ─────────────────────────────────────

# Local command that runs the audio-language assessor. The first supported
# assessor is Qwen2.5-Omni-7B via scripts/audio_assessor_qwen_omni.py.
STABLE_AUDIO_ASSESSOR_COMMAND=uv run --with torch --with torchvision --with transformers --with accelerate --with soundfile --with librosa --with qwen-omni-utils python scripts/audio_assessor_qwen_omni.py

# Assessor subprocess timeout (ms). Default 300000 (5m). Use 900000 for the
# first run, which resolves Python packages and downloads model weights.
STABLE_AUDIO_ASSESSOR_TIMEOUT_MS=900000

# Hugging Face model id for the Qwen Omni assessor.
QWEN_OMNI_MODEL=Qwen/Qwen2.5-Omni-7B

# Max audio duration (seconds) passed to the assessor after ffmpeg conversion.
# Use 0 to send the full file regardless of length. Default 120.
QWEN_OMNI_MAX_AUDIO_SECONDS=120

# Optional tuning for the assessor model. Defaults shown.
# QWEN_OMNI_MAX_NEW_TOKENS=768
# QWEN_OMNI_DTYPE=auto
# QWEN_OMNI_DEVICE_MAP=auto

# ─── YouTube reference extraction ───────────────────────────────────────────

# Deterministic yt-dlp + ffmpeg extraction (no LLM/agent). Requires the yt-dlp
# binary and ffmpeg (FFMPEG_PATH or on PATH). The temporary MP3 lives under
# .stable-audio-assessments/uploads/ and is deleted after assessment.
# STABLE_AUDIO_YOUTUBE_YTDLP_BIN=yt-dlp

# YouTube extraction timeout (ms). Default 300000 (5m). Honors the legacy alias
# STABLE_AUDIO_YOUTUBE_CODEX_TIMEOUT_MS from older deployments for back-compat.
# STABLE_AUDIO_YOUTUBE_TIMEOUT_MS=300000

# ─── Ollama (auto-title + radio prompt drafting) ────────────────────────────

# Ollama base URL override. Wins over the HOST/PORT composition below. Pinned to
# loopback by default; operator-configurable only.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama host/port (used when OLLAMA_BASE_URL is unset). Defaults 127.0.0.1:11434.
# OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Model used for AI title generation via /api/generate-title. Default phi4-mini.
OLLAMA_TITLE_MODEL=phi4-mini

# ─── Radio station ──────────────────────────────────────────────────────────

# Codex CLI used for taste distillation and style drafting. Default "codex".
# RADIO_CODEX_BIN=codex

# Model overrides for Codex taste/style runs (optional).
# RADIO_CODEX_TASTE_MODEL=
# RADIO_CODEX_STYLE_MODEL=

# Timeout (ms) for a Codex taste/style run. Default 120000 (2m).
# RADIO_CODEX_TASTE_TIMEOUT_MS=120000

# Timeout (ms) for the radio queue's Ollama prompt-draft call. Default 120000.
# RADIO_OLLAMA_TIMEOUT_MS=120000

# Timeout (ms) for the Ollama /api/tags model-list probe in GET /api/radio.
# Default 1000.
# RADIO_OLLAMA_MODELS_TIMEOUT_MS=1000

# Set to "false" to disable the background queue auto-fill loop. Default runs it.
# RADIO_QUEUE_AUTO_FILL=true

# Optional explicit LAN host for stream/playlist URLs (e.g. 192.168.1.10).
# Fallbacks: RADIO_LAN_HOST > LAN_IP > detected LAN IP.
# RADIO_LAN_HOST=
# LAN_IP=

# Optional public origin for public stream URLs, e.g. https://radio.pardev.net.
# When set, GET /api/radio advertises a public stream URL alongside the LAN one.
# RADIO_PUBLIC_ORIGIN=

# ─── Radio TTS (DJ announcements) ───────────────────────────────────────────
#
# The TTS pipeline is provided by the local par-tts-core-ts package, which is
# NOT declared as a package.json dependency (it lives out-of-tree and is
# unpublished). Point the env vars below at its built CommonJS entry to enable
# announcements; leave them unset to run the station without DJ announcements
# (the stream never crashes on a missing module — the failure is logged and the
# announcement is skipped).
#
# Provider TTS (openai / elevenlabs / deepgram / gemini):
# RADIO_TTS_MODULE_PATH=<REPO_ROOT>/../par-tts-core-ts/dist/index.cjs
#
# Kokoro ONNX TTS uses the Node-specific entry:
# RADIO_TTS_NODE_MODULE_PATH=<REPO_ROOT>/../par-tts-core-ts/dist/node/index.cjs
#
# Optional model id passed through to the TTS pipeline:
# RADIO_TTS_MODEL=

# Optional path to the par-tts YAML config file (an alternative place for
# provider keys/voices).
# PAR_TTS_CONFIG_PATH=

# Provider TTS API keys are resolved from THIS file (.env.local) / the process
# environment ONLY. Resolution order: PAR_TTS_CONFIG_PATH file, then the env
# vars below. Kokoro needs no key.
#
# SECURITY NOTE (SEC-006): the app NO LONGER reads ~/.claude/.env for TTS
# provider keys. If you previously relied on keys stored there, MIGRATE them
# into .env.local (e.g. OPENAI_API_KEY=sk-...). See
# docs/troubleshooting/common-errors.md ("Radio: no DJ announcements or TTS
# silent").
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# DEEPGRAM_API_KEY=
# DG_API_KEY=              # alias for DEEPGRAM_API_KEY
# GEMINI_API_KEY=
# GOOGLE_API_KEY=          # alias for GEMINI_API_KEY

# ─── Dev server ─────────────────────────────────────────────────────────────

# Port the Next.js dev/app server listens on. Default 3007.
# PORT=3007

# scripts/dev-server.mjs: delay (ms) before restarting the dev server after a
# crash. Optional.
# DEV_SERVER_RESTART_DELAY_MS=
