# Optional for optimized MLX weights; required for gated standard repos after you accept Stability's license.
HF_TOKEN=

# Force mock output instead of model inference. Good for UI testing.
STABLE_AUDIO_MOCK=true

# Python executable for the bridge script. Defaults to python3.
STABLE_AUDIO_PYTHON=python3

# Real inference backend. MLX is the recommended Apple Silicon path for all models.
STABLE_AUDIO_BACKEND=mlx

# Optional override for the vendored MLX runtime directory.
# STABLE_AUDIO_MLX_DIR=/Users/probello/Repos/stable-audio-3-lab/vendor/stable-audio-3/optimized/mlx

# Generation timeout in milliseconds.
STABLE_AUDIO_TIMEOUT_MS=900000

# Local audio assessor used by /api/assess. The first supported assessor is
# Qwen2.5-Omni-7B through scripts/audio_assessor_qwen_omni.py.
STABLE_AUDIO_ASSESSOR_COMMAND=uv run --with torch --with torchvision --with transformers --with accelerate --with soundfile --with librosa --with qwen-omni-utils python scripts/audio_assessor_qwen_omni.py
STABLE_AUDIO_ASSESSOR_TIMEOUT_MS=900000
QWEN_OMNI_MODEL=Qwen/Qwen2.5-Omni-7B
QWEN_OMNI_MAX_AUDIO_SECONDS=120

# Deterministic YouTube reference-track extraction (replaces the previous
# autonomous Codex agent). Requires the yt-dlp binary and ffmpeg on PATH (or
# set FFMPEG_PATH to the ffmpeg binary so its directory is passed to yt-dlp via
# --ffmpeg-location).
# STABLE_AUDIO_YOUTUBE_YTDLP_BIN=yt-dlp
# STABLE_AUDIO_YOUTUBE_TIMEOUT_MS=300000

# Optional shared-secret bearer token that gates mutating /api/* routes
# (POST/PUT/PATCH/DELETE). UNSET BY DEFAULT: when empty, all routes work as
# before with no authentication (the intended localhost/single-user mode). When
# set to a high-entropy value, mutating requests must send
#   Authorization: Bearer <STABLE_AUDIO_ADMIN_TOKEN>
# Read-only GET routes (including the public GET /api/radio JSON contract and
# the ?stream=1 MP3 stream) are never gated. Never commit a real token; supply
# it via the operator environment.
# STABLE_AUDIO_ADMIN_TOKEN=

# Per-client rate limit for mutating /api/* requests, in requests per minute
# (token bucket). 0 disables limiting. Default 30. Fail-open on cold restart.
# STABLE_AUDIO_MUTATING_RATE_PER_MINUTE=30

# Maximum number of heavy subprocesses (generation, crop, assessment) that may
# run concurrently. Default 1; raise only on hardware that can host multiple
# inferences without exhausting unified memory.
# STABLE_AUDIO_MAX_CONCURRENT=1

# Ollama configuration for auto-title generation.
OLLAMA_TITLE_MODEL=phi4-mini
OLLAMA_PORT=11434

# Radio DJ announcements (optional). The TTS pipeline is provided by the local
# par-tts-core-ts package, which is NOT declared as a package.json dependency
# (it lives out-of-tree and is unpublished). Point the env var below at its
# built CommonJS entry to enable announcements; leave it unset to run the
# station without DJ announcements (the stream never crashes on a missing
# module — the failure is logged and the announcement is skipped).
#
# Provider TTS (openai/elevenlabs/deepgram/gemini):
# RADIO_TTS_MODULE_PATH=/Users/<you>/Repos/par-tts-core-ts/dist/index.cjs
#
# Kokoro ONNX TTS uses the Node-specific entry:
# RADIO_TTS_NODE_MODULE_PATH=/Users/<you>/Repos/par-tts-core-ts/dist/node/index.cjs
#
# Optional model id passed through to the TTS pipeline:
# RADIO_TTS_MODEL=
#
# TTS provider API keys are resolved in this order: par-tts config file
# (PAR_TTS_CONFIG_PATH), then process env (OPENAI_API_KEY / ELEVENLABS_API_KEY /
# DEEPGRAM_API_KEY / DG_API_KEY / GEMINI_API_KEY / GOOGLE_API_KEY). Kokoro needs
# no key. Do NOT set a personal absolute path in code — always configure it here.

